{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Downloader",
  "version": "2.0.2",
  "identifier": "com.codewithroni.universaldownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Universal Downloader",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0b0d14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; media-src 'self' https: blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Fast video & audio downloader",
    "longDescription": "Universal Downloader — download videos, audio (MP3) and whole playlists from YouTube and 1000+ sites.",
    "publisher": "CodeWithRoni",
    "copyright": "© Md. Amzad Hossain Roni",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
